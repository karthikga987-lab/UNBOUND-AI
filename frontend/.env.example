# Copy to frontend/.env.local and adjust. Restart `npm run dev` after changes.

# --- Task / document APIs ---
# Use the real FastAPI backend by default. Set true only for an explicitly labelled demo.
VITE_USE_MOCK=false
# Optional comma-separated demo-only areas. Keep empty for real API behavior.
VITE_MOCK_AREAS=
# Where the dev server proxies /api to (default Local Demo backend on port 8001)
# VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8001

# --- Live View (browser engine, Member 2). Leave unset until the backend provides them. ---
# websocket | sse | polling
# VITE_LIVE_TRANSPORT=websocket
# Placeholders: {task_id}, {after}
# VITE_LIVE_EVENTS_URL=ws://localhost:5173/api/browser/sessions/{task_id}/events?after={after}
# VITE_LIVE_POLL_MS=1500
# VITE_LIVE_PAUSE_URL=/api/browser/sessions/{task_id}/pause
# VITE_LIVE_RESUME_URL=/api/browser/sessions/{task_id}/resume
