[Unit]
Description=UNBOUND isolated browser worker (disabled until separately reviewed)
Requires=unbound-renderer.service
Requires=unbound-guest-network-policy.service
After=network.target unbound-renderer.service unbound-guest-network-policy.service
ConditionPathExists=/etc/unbound-browser-worker/worker.env

[Service]
Type=simple
User=unbound-worker
Group=unbound-ipc
SupplementaryGroups=unbound-worker
UMask=0077
RuntimeDirectory=unbound-browser-worker
RuntimeDirectoryMode=0750
StateDirectory=unbound-browser-worker
StateDirectoryMode=0700
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
WorkingDirectory=/opt/unbound-gate-a
Environment=PYTHONNOUSERSITE=1
EnvironmentFile=/etc/unbound-browser-worker/worker.env
Environment=UNBOUND_RENDERER_MODE=broker_fetch
Environment=UNBOUND_WORKER_PROXY_USERNAME=unbound
Environment=UNBOUND_WORKER_PROXY_ENDPOINT=https://192.168.56.1:18765
LoadCredential=app.key:/etc/unbound-browser-worker/app.key
LoadCredential=server.cert:/etc/unbound-browser-worker/server.cert
LoadCredential=server.key:/etc/unbound-browser-worker/server.key
LoadCredential=host-client-ca.pem:/etc/unbound-browser-worker/host-client-ca.pem
LoadCredential=proxy.password:/etc/unbound-browser-worker/proxy.password
LoadCredential=host.pub:/etc/unbound-browser-worker/host.pub
LoadCredential=proxy-client.cert:/etc/unbound-browser-worker/broker-client-cert.pem
LoadCredential=proxy-client.key:/etc/unbound-browser-worker/broker-client-key.pem
LoadCredential=proxy-ca.pem:/etc/unbound-browser-worker/gateway-server-ca.pem
Environment=UNBOUND_WORKER_PRIVATE_KEY_FILE=%d/app.key
Environment=UNBOUND_WORKER_TLS_CERT_FILE=%d/server.cert
Environment=UNBOUND_WORKER_TLS_KEY_FILE=%d/server.key
Environment=UNBOUND_WORKER_CLIENT_CA_FILE=%d/host-client-ca.pem
Environment=UNBOUND_WORKER_PROXY_PASSWORD_FILE=%d/proxy.password
Environment=UNBOUND_WORKER_HOST_PUBLIC_KEY_FILE=%d/host.pub
Environment=UNBOUND_WORKER_PROXY_CLIENT_CERT_FILE=%d/proxy-client.cert
Environment=UNBOUND_WORKER_PROXY_CLIENT_KEY_FILE=%d/proxy-client.key
Environment=UNBOUND_WORKER_PROXY_CA_FILE=%d/proxy-ca.pem
ExecStart=/opt/unbound-gate-a/.venv-worker/bin/python -m backend.app.browser.worker_service
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=mixed
CPUQuota=100%
MemoryMax=2G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=192.168.56.1/32
ReadWritePaths=/var/lib/unbound-browser-worker

[Install]
WantedBy=multi-user.target
